APP_NAME=PPA-Sense
ENVIRONMENT=development
# Step 4 follows the requested Anthropic provider. Local embeddings remain free of API calls.
LLM_PROVIDER=anthropic
# Set a tool-capable Claude model available in your account; no hard-coded model in code.
LLM_MODEL=
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional model commit SHA. Leave unset to resolve the current cached/downloaded revision.
# EMBEDDING_REVISION=commit_sha_here
EMBEDDING_BATCH_SIZE=32
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=contract_chunks
DOCUMENTS_PATH=data/documents
MAX_UPLOAD_BYTES=52428800
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
